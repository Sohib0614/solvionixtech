# ==============================================
# Solvionix Environment Configuration
# ==============================================
# Copy this file to .env and fill in the values.

# Optional: Google Gemini API Key for conversational AI assistant
# If omitted, the assistant falls back to the deterministic local knowledge engine.
VITE_GEMINI_API_KEY=

# Optional: Form submission endpoint (e.g. Formspree, Web3Forms, or custom webhook)
# Example: https://formspree.io/f/your_form_id
# If omitted, the form runs in safe demo mode.
VITE_FORM_ENDPOINT=

# Optional: Direct Contact details (digits only for WhatsApp, no spaces or '+')
# Example: 923001234567
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_EMAIL=contact@solvionix.com
VITE_CONTACT_PHONE=+92 300 1234567
VITE_CONTACT_LOCATION=Remote / Global
